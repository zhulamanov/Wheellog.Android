<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginVertical="5dp"
    app:cardCornerRadius="10dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textSize="19sp" android:fontFamily="@font/prime"
                android:maxLines="2" android:ellipsize="end" />
            <ImageButton android:id="@+id/popupButton" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@android:color/transparent" android:contentDescription="@string/track_actions"
                android:padding="10dp" app:srcCompat="@drawable/ic_more_vert_24" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="150dp">
            <com.cooper.wheellog.track.TrackThumbnailView android:id="@+id/thumbnail"
                android:layout_width="0dp" android:layout_weight="0.38" android:layout_height="match_parent" android:minHeight="150dp" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="0.62" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="0dp">
                <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/prime" android:textSize="14sp" />
                <TextView android:id="@+id/description2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/prime" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
